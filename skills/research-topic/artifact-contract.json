{
  "artifact_type": "topic",
  "document": {
    "additional_h2": true,
    "evidence_rules": [
      "所有 Topic 页使用 type: topic；kind 必须匹配请求的 output role：overview/resources/outline/card",
      "frontmatter 只允许 JSON Schema 声明的字段；请求的 research_key、topic_slug、query 等编排字段不写入产物",
      "outline 必须有非空 subquestions，id 唯一；subquestions/history 仅用于 outline",
      "outline.items 只登记请求已接纳的 Book/Paper/Talk；cards 只登记已提供的证据卡，不以待办需求充当证据",
      "created/themes/archives 仅用于 card；archives 不重复，新的 Archive 证据卡按请求记录 exact Archive paths",
      "保留已有用户组织与正文内容；按合法 schema 修正元数据，不把旧的非法字段当作新格式依据"
    ],
    "h1": "使用 frontmatter.title",
    "metadata_lines": [],
    "section_order": [],
    "sections": []
  },
  "frontmatter": {
    "field_order": [
      "type",
      "title",
      "kind",
      "subquestions",
      "history",
      "created",
      "themes",
      "archives"
    ],
    "json_schema": {
      "$defs": {
        "SubqItem": {
          "additionalProperties": false,
          "description": "子问题的一个学术语料成员(持久在 outline frontmatter,跨轮跨重跑累计)。\n\n只收 vault 分析件(book/paper/talk)。圈外证据卡走 `Subquestion.cards`\n独立通道 —— 卡不是分析件,混进来会让 synth 按分析件路径去读一个不存在的产物。",
          "properties": {
            "kind": {
              "enum": [
                "book",
                "paper",
                "talk"
              ],
              "title": "Kind",
              "type": "string"
            },
            "role": {
              "anyOf": [
                {
                  "enum": [
                    "evidence",
                    "theory",
                    "method",
                    "context"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Role"
            },
            "slug": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
              "title": "Slug",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "slug"
          ],
          "title": "SubqItem",
          "type": "object"
        },
        "Subquestion": {
          "additionalProperties": false,
          "description": "研究大纲里的一个子问题(仅 kind: outline 页携带)。",
          "properties": {
            "cards": {
              "description": "证据卡 slug 表(cards/{slug}.md),与 items 平行的圈外证据通道",
              "items": {
                "maxLength": 80,
                "minLength": 2,
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              },
              "maxItems": 50,
              "title": "Cards",
              "type": "array"
            },
            "channel": {
              "default": "academic",
              "enum": [
                "academic",
                "web",
                "mixed"
              ],
              "title": "Channel",
              "type": "string"
            },
            "coverage": {
              "enum": [
                "gap",
                "thin",
                "covered",
                "saturated"
              ],
              "title": "Coverage",
              "type": "string"
            },
            "id": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
              "title": "Id",
              "type": "string"
            },
            "items": {
              "items": {
                "$ref": "#/$defs/SubqItem"
              },
              "maxItems": 50,
              "title": "Items",
              "type": "array"
            },
            "question": {
              "maxLength": 280,
              "minLength": 4,
              "title": "Question",
              "type": "string"
            },
            "theory_used": {
              "default": 0,
              "minimum": 0,
              "title": "Theory Used",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "question",
            "coverage"
          ],
          "title": "Subquestion",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "A topic overview, resources page, outline state, or evidence card.",
      "properties": {
        "archives": {
          "anyOf": [
            {
              "items": {
                "pattern": "^vault/archives/(?:[^./\\\\\\x00-\\x1f][^/\\\\\\x00-\\x1f]*/)?[a-z0-9]+(?:-[a-z0-9]+)*/archive\\.md$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本卡引用的 Archive canonical paths；仅 kind: card；旧卡可省略",
          "title": "Archives"
        },
        "created": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created"
        },
        "history": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History"
        },
        "kind": {
          "description": "页面类型: overview 综合页 / resources 资源页 / outline 研究大纲 / card 圈外证据卡",
          "enum": [
            "overview",
            "resources",
            "outline",
            "card"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subquestions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Subquestion"
              },
              "maxItems": 6,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subquestions"
        },
        "themes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "主题标签数组(复用全库 themes 词表);仅 kind: card",
          "title": "Themes"
        },
        "title": {
          "maxLength": 280,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "topic",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "kind"
      ],
      "title": "TopicSchema",
      "type": "object"
    }
  },
  "identity": {
    "fields": [
      "title",
      "kind"
    ],
    "properties": {
      "kind": {
        "description": "页面类型: overview 综合页 / resources 资源页 / outline 研究大纲 / card 圈外证据卡",
        "enum": [
          "overview",
          "resources",
          "outline",
          "card"
        ],
        "title": "Kind",
        "type": "string"
      },
      "title": {
        "maxLength": 280,
        "minLength": 2,
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "title",
      "kind"
    ]
  },
  "path_pattern": "vault/topics/{slug}/{00-overview.md|01-resources.md|02-outline.md|cards/{card-slug}.md}",
  "schema_version": "quasi.artifact.topic/0.1"
}
