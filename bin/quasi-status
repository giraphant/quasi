#!/usr/bin/env bash
# quasi-status — read-only factual on-disk material observation.
#
# Usage:
#   quasi-status --kind paper|book|talk|author|topic --slug SLUG --json
#   quasi-status --kind translation --slug SLUG --target-language TAG --json
#   quasi-status --scan --json

set -e

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
DATA_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.cache/quasi}"
PYTHON="$DATA_DIR/.venv/bin/python"

[ -x "$PYTHON" ] || "$PLUGIN_ROOT/scripts/bootstrap-venv.sh"

exec "$PYTHON" "$PLUGIN_ROOT/scripts/status/status.py" "$@"
