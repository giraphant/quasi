#!/usr/bin/env bash
# quasi-transcribe — deterministic multi-engine transcription for process-talk.
#
# Usage:
#   quasi-transcribe observe --media FILE --slug SLUG --title T --date YYYY-MM-DD --json
#   quasi-transcribe prepare-media --media FILE --output vault/talks/SLUG/recording.mp4 --json
#   quasi-transcribe run --media FILE --slug SLUG [--title T] [--engines a,b,c] [--lang auto] [--json]
#   quasi-transcribe classify (--slug SLUG | --transcript FILE) [--json]
#   quasi-transcribe silent --slug SLUG --title T --date YYYY-MM-DD --media FILE \
#     --transcript PATH --state dead|empty --mode create|repair --output PATH [--json]
#
# Strict --json calls emit one closed Operation receipt.  Legacy calls retain
# their historical JSON/prose surface.  Per-engine transcripts are committed
# under processing/talks/<slug>/.

set -e

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
. "$PLUGIN_ROOT/scripts/load-keychain-env.sh"
DATA_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.cache/quasi}"
PYTHON="$DATA_DIR/.venv/bin/python"

[ -x "$PYTHON" ] || "$PLUGIN_ROOT/scripts/bootstrap-venv.sh"

exec "$PYTHON" "$PLUGIN_ROOT/scripts/transcribe/transcribe.py" "$@"
